{
  "seed": 42,
  "pair_holdout_fraction": 0.1,
  "batch_size": 8,
  "text_batch_size": 16,
  "prompt": "a photo of a {crop} leaf with {disease}",
  "crop_prompt": "a photo of a {crop} leaf",
  "disease_prompt": "a photo of a leaf with {disease}",
  "coefficient_grid": [[1, 0, 0], [0.75, 0.125, 0.125], [0.5, 0.25, 0.25], [0.5, 0.5, 0], [0.5, 0, 0.5], [0, 0.5, 0.5]],
  "models": {
    "clip_b16": {"backend": "open_clip", "architecture": "ViT-B-16", "pretrained": "openai"},
    "clip_l14": {"backend": "open_clip", "architecture": "ViT-L-14", "pretrained": "openai"},
    "siglip2": {"backend": "transformers", "repository": "google/siglip2-base-patch16-224", "revision": "main"},
    "bioclip": {"backend": "open_clip_hub", "repository": "imageomics/bioclip", "revision": "main"}
  }
}
