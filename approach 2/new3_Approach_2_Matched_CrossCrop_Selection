    "    if set(pairs) != lookup.keys():\n",
    "        raise ValueError(\"Candidate identities differ from the common evaluator.\")\n",
    "    to_common = torch.tensor([lookup[pair] for pair in pairs])\n",
    "    canonical_targets = to_common[seen_targets]\n",
    "    if (canonical_targets >= len(train_pairs)).any():\n",
    "        raise ValueError(\"The common confusion plot expects seen target rows.\")\n",
    "    for name, winners in seen_winners.items():\n",
    "        votes = F.one_hot(to_common[winners], num_classes=len(pairs)).float()\n",
