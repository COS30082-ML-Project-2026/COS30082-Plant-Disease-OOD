    "class MultiTaskNet(nn.Module):\n",
    "    \"\"\"Latest Baseline 2 architecture.\"\"\"\n",
    "    def __init__(self, pretrained):\n",
    "        super().__init__()\n",
    "        self.backbone = timm.create_model(BACKBONE, pretrained=pretrained, num_classes=0,\n",
    "                                          img_size=team.IMAGE_SIZE)\n",
    "        self.backbone.requires_grad_(False)\n",
    "        self.crop_head = nn.Linear(self.backbone.num_features, NUM_CROPS)\n",
    "        self.disease_head = nn.Linear(self.backbone.num_features, NUM_DISEASES)\n",
    "\n",
    "    def forward(self, images):\n",
    "        features = self.backbone(images)\n",
    "        return self.logits_from_features(features)\n",
    "\n",
    "    def logits_from_features(self, features):\n",
    "        return self.crop_head(features), self.disease_head(features)\n",
    "\n",
    "\n",
    "def pair_scores(crop_logits, disease_logits, pairs):\n",
    "    pairs = pairs.to(crop_logits.device)\n",
    "    crop_log = F.log_softmax(crop_logits.float(), dim=1)\n",
    "    disease_log = F.log_softmax(disease_logits.float(), dim=1)\n",
    "    return crop_log[:, pairs[:, 0]] + disease_log[:, pairs[:, 1]]\n",
    "\n",
    "\n",
    "def center_logits(logits):\n",
    "    # Remove the per-image offset to which categorical predictions are invariant.\n",
    "    return logits - logits.mean(dim=1, keepdim=True)\n",
    "\n",
    "\n",
    "def decorrelation(crop, disease):\n",
    "    def standardize(x):\n",
    "        x = x - x.mean(0)\n",
    "        return x / (x.square().mean(0) + 1e-4).sqrt()\n",
    "\n",
    "    cross_correlation = standardize(crop).T @ standardize(disease) / len(crop)\n",
    "    return cross_correlation.square().mean()\n",
    "\n",
    "\n",
    "def cross_crop_supcon(embedding, crop, disease):\n",
    "    z = F.normalize(embedding, dim=1)\n",
    "    same_disease = disease[:, None].eq(disease[None, :])\n",
    "    positives = same_disease & crop[:, None].ne(crop[None, :])\n",
    "    negatives = ~same_disease\n",
    "    similarity = z @ z.T / TEMPERATURE\n",
    "    normalizer = similarity.masked_fill(~(positives | negatives), -1e9).logsumexp(dim=1)\n",
    "    counts = positives.sum(dim=1)\n",
    "    positive_mean = similarity.masked_fill(~positives, 0.0).sum(dim=1) / counts.clamp_min(1)\n",
    "    usable = (counts > 0) & negatives.any(dim=1)\n",
    "    per_anchor = (normalizer - positive_mean).masked_fill(~usable, 0.0)\n",
    "    return per_anchor.sum() / usable.sum().clamp_min(1), usable.sum()\n",
    "\n",
    "\n",
    "class PairFusionNet(MultiTaskNet):\n",
    "    \"\"\"Predict crop, disease, and a residual compatibility for each candidate pair.\"\"\"\n",
    "\n",
    "    def __init__(self, pretrained):\n",
    "        super().__init__(pretrained=pretrained)\n",
    "        width = self.backbone.num_features\n",
    "        self.crop_projection = nn.Sequential(nn.Linear(width, PROJECTION_DIM), nn.LayerNorm(PROJECTION_DIM))\n",
    "        self.disease_projection = nn.Sequential(nn.Linear(width, PROJECTION_DIM), nn.LayerNorm(PROJECTION_DIM))\n",
    "        self.crop_projected_head = nn.Linear(PROJECTION_DIM, NUM_CROPS, bias=False)\n",
    "        self.disease_projected_head = nn.Linear(PROJECTION_DIM, NUM_DISEASES, bias=False)\n",
    "        nn.init.zeros_(self.crop_projected_head.weight)\n",
    "        nn.init.zeros_(self.disease_projected_head.weight)\n",
    "        self.fusion = nn.Sequential(nn.Linear(2 * PROJECTION_DIM, PROJECTION_DIM), nn.GELU(),\n",
    "                                    nn.Linear(PROJECTION_DIM, PROJECTION_DIM))\n",
    "        self.crop_prototypes = nn.Embedding(NUM_CROPS, PROJECTION_DIM)\n",
    "        self.disease_prototypes = nn.Embedding(NUM_DISEASES, PROJECTION_DIM)\n",
    "\n",
    "    def encode(self, images):\n",
    "        return self.encode_features(self.backbone(images))\n",
    "\n",
    "    def encode_features(self, base):\n",
    "        crop = self.crop_projection(base)\n",
    "        disease = self.disease_projection(base)\n",
    "        crop_logits = self.crop_head(base) + self.crop_projected_head(crop)\n",
    "        disease_logits = self.disease_head(base) + self.disease_projected_head(disease)\n",
    "        return crop_logits, disease_logits, crop, disease\n",
    "\n",
    "    def forward(self, images):\n",
    "        crop_logits, disease_logits, _, _ = self.encode(images)\n",
    "        return crop_logits, disease_logits\n",
    "\n",
    "    def score_components(self, crop_logits, disease_logits, crop, disease, pairs):\n",
    "        pairs = pairs.to(crop.device)\n",
    "        joint = F.normalize(self.fusion(torch.cat((crop, disease), dim=1)), dim=1)\n",
    "        prototypes = self.crop_prototypes(pairs[:, 0]) * self.disease_prototypes(pairs[:, 1])\n",
    "        prototypes = F.normalize(prototypes, dim=1)\n",
    "        return pair_scores(crop_logits, disease_logits, pairs) + FUSION_WEIGHT * (joint @ prototypes.T)\n",
    "\n",
    "\n",
    "def build_network(spec, pretrained):\n",
    "    network = PairFusionNet if spec[\"fusion\"] else MultiTaskNet\n",
    "    return network(pretrained=pretrained)\n",
    "\n",
    "\n",
    "def score_images(model, images, pairs):\n",
    "    return score_features(model, model.backbone(images), pairs)\n",
    "\n",
    "\n",
    "def score_features(model, features, pairs):\n",
    "    if isinstance(model, PairFusionNet):\n",
    "        components = model.encode_features(features)\n",
    "        return model.score_components(*components, pairs), components[:2]\n",
    "    logits = model.logits_from_features(features)\n",
    "    return pair_scores(*logits, pairs), logits\n",
    "\n",
    "\n",
    "class CrossCropBatchSampler:\n",
    "    \"\"\"Batch eligible cross-crop pairs together while visiting each fit image once.\"\"\"\n",
    "\n",
    "    def __init__(self, frame, batch_size):\n",
    "        self.crops = frame.crop.tolist()\n",
    "        self.diseases = frame.disease.tolist()\n",
    "        self.by_disease = frame.groupby(\"disease\").indices\n",
    "        self.batch_size = batch_size\n",
    "        self.epoch = 0\n",
    "\n",
    "    def __len__(self):\n",
    "        return (len(self.crops) + self.batch_size - 1) // self.batch_size\n",
    "\n",
    "    def __iter__(self):\n",
    "        rng = random.Random(team.SEED + self.epoch)\n",
    "        self.epoch += 1\n",
    "        order = rng.sample(range(len(self.crops)), k=len(self.crops))\n",
    "        remaining, batch = set(order), []\n",
    "        for index in order:\n",
    "            if index not in remaining:\n",
    "                continue\n",
    "            remaining.remove(index)\n",
    "            batch.append(index)\n",
    "            if len(batch) < self.batch_size:\n",
    "                eligible = [other for other in self.by_disease[self.diseases[index]]\n",
    "                            if other in remaining and self.crops[other] != self.crops[index]]\n",
    "                if eligible:\n",
    "                    donor = int(rng.choice(eligible))\n",
    "                    remaining.remove(donor)\n",
    "                    batch.append(donor)\n",
    "            if len(batch) == self.batch_size:\n",
    "                yield batch\n",
    "                batch = []\n",
    "        if batch:\n",
    "            yield batch\n",
    "\n",
    "\n",
    "def cross_crop_sources(crop, disease):\n",
    "    eligible = disease[:, None].eq(disease[None, :]) & crop[:, None].ne(crop[None, :])\n",
    "    rows = eligible.any(dim=1).nonzero(as_tuple=True)[0]\n",
    "    donors = eligible[rows].to(torch.int64).argmax(dim=1)\n",
    "    return rows, donors\n",
    "\n",
    "\n",
    "def make_fit_loader(frame, transform, spec):\n",
    "    dataset = PlantDataset(frame, transform, \"imagenet\")\n",
    "    options = {\"num_workers\": team.NUM_WORKERS, \"generator\": torch.Generator().manual_seed(team.SEED)}\n",
    "    if spec[\"cross_crop_batches\"]:\n",
    "        return DataLoader(dataset, batch_sampler=CrossCropBatchSampler(dataset.frame, BATCH_SIZE), **options)\n",
    "    return DataLoader(dataset, batch_size=BATCH_SIZE, shuffle=True, **options)\n",
    "\n",
    "\n",
    "def training_objective(spec, fit):\n",
    "    fit_pairs = target_lookup = None\n",
    "    if spec[\"fusion\"]:\n",
    "        fit_ids = torch.tensor(sorted(fit.pair_row.unique()), dtype=torch.long)\n",
    "        fit_pairs = train_pairs[fit_ids].to(DEVICE)\n",
    "        target_lookup = torch.full((len(train_pairs),), -1, dtype=torch.long)\n",
    "        target_lookup[fit_ids] = torch.arange(len(fit_ids))\n",
    "        target_lookup = target_lookup.to(DEVICE)\n",
    "\n",
    "    def objective(model, criterion, features, crop, disease, pair_rows):\n",
    "        if spec[\"fusion\"]:\n",
    "            components = model.encode_features(features)\n",
    "            crop_logits, disease_logits = components[:2]\n",
    "        else:\n",
    "            crop_logits, disease_logits = model.logits_from_features(features)\n",
    "\n",
    "        disease_repr = center_logits(disease_logits)\n",
    "        loss = criterion(crop_logits, crop) + criterion(disease_logits, disease)\n",
    "        loss = loss + spec[\"decor\"] * decorrelation(center_logits(crop_logits), disease_repr)\n",
    "        supcon_anchors = 0\n",
    "        if spec[\"supcon\"]:\n",
    "            contrast, supcon_anchors = cross_crop_supcon(disease_repr, crop, disease)\n",
    "            loss = loss + spec[\"supcon\"] * contrast\n",
    "        swaps = 0\n",
    "        if spec[\"fusion\"]:\n",
    "            targets = target_lookup[pair_rows]\n",
    "            # Every fit target uses the same train-only candidate table for both arms.\n",
    "            per_image = F.cross_entropy(model.score_components(*components, fit_pairs), targets, reduction=\"none\")\n",
    "            pair_loss = per_image.sum()\n",
    "            if spec[\"swap\"]:\n",
    "                anchors, donors = cross_crop_sources(crop, disease)\n",
    "                swaps = len(anchors)\n",
    "                if swaps:\n",
    "                    c_logits, d_logits, c_features, d_features = components\n",
    "                    swapped = model.score_components(c_logits[anchors], d_logits[donors],\n",
    "                                                     c_features[anchors], d_features[donors], fit_pairs)\n",
    "                    swap_loss = F.cross_entropy(swapped, targets[anchors], reduction=\"sum\")\n",
    "                    pair_loss = pair_loss + 0.5 * (swap_loss - per_image[anchors].sum())\n",
    "            loss = loss + PAIR_LOSS_WEIGHT * pair_loss / len(features)\n",
    "        return loss, supcon_anchors, swaps\n",
    "\n",
    "    return objective"
   ],
