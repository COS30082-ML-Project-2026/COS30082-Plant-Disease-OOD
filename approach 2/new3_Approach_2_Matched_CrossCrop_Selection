    "                \"recipe_spec\": spec, \"seen_pairs\": train_pairs.tolist(), \"selection\": selection[\"selection\"],\n",
    "                \"gamma\": selection[\"gamma\"], \"refit\": refit}\n",
    "    atomic_save(checkpoint, {\"state_dict\": model.cpu().state_dict(), **metadata})\n",
