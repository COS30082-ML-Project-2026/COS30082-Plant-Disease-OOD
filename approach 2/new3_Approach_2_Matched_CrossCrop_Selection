    "    atomic_json(folder / \"selection_lock.json\", lock)\n",
    "    print(f\"Locked checkpoint: {checkpoint.resolve()} ({checkpoint.stat().st_size / 1e6:.1f} MB)\", flush=True)\n",
    "    return lock\n",
    "\n",
    "\n",
    "def refit_selected():\n",
