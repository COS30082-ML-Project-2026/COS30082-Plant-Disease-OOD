    "    def __len__(self):\n",
    "        return len(self.names)\n",
    "\n",
    "    def __getitem__(self, index):\n",
    "        with Image.open(team.IMAGE_DIR / self.names[index]) as image:\n",
    "            return image_transform(image.convert(\"RGB\"))\n",
    "\n",
    "\n",
    "def official_targets(csv_path, filenames, row_by_pair, *, seen):\n",
    "    # This per-image projection is used after predictions. Ignore the official pair_label column.\n",
    "    frame = pd.read_csv(csv_path, header=None, usecols=[0, 1, 2], dtype=str, keep_default_na=False)\n",
    "    frame.columns = [\"image\", \"crop\", \"disease\"]\n",
    "    if not frame.empty and not frame.iloc[0][\"crop\"].strip().isdigit():\n",
    "        frame = frame.iloc[1:]\n",
    "    if frame.image.map(image_key).tolist() != filenames:\n",
    "        raise ValueError(\"Official targets and predictions have different image orders.\")\n",
    "    keys = frame[[\"crop\", \"disease\"]].astype(\"int64\").itertuples(index=False, name=None)\n",
    "    try:\n",
    "        labels = torch.tensor([row_by_pair[key] for key in keys], dtype=torch.long)\n",
    "    except KeyError as error:\n",
    "        raise ValueError(f\"Official ground-truth pair absent from the frozen candidate table: {error}\") from error\n",
    "    if not ((labels < team.NUM_SEEN_PAIRS) == seen).all():\n",
    "        raise ValueError(\"Official test split does not match seen membership.\")\n",
    "    return labels\n",
    "\n",
    "\n",
    "def top_predictions(scores, offset=0):\n",
    "    return {k: scores.topk(k, dim=1).indices + offset for k in (1, 5)}\n",
    "\n",
    "\n",
    "def prediction_accuracy(predictions, labels):\n",
    "    return round(100 * predictions.eq(labels[:, None]).any(1).float().mean().item(), 2)\n",
    "\n",
    "\n",
    "@torch.inference_mode()\n",
    "def predict_official(model, pairs, filenames, split, perturb=None):\n",
    "    loader = DataLoader(OfficialImages(filenames), batch_size=BATCH_SIZE, shuffle=False,\n",
    "                        num_workers=0, generator=torch.Generator().manual_seed(team.SEED))\n",
    "    mean, std = (torch.tensor(v).view(1, 3, 1, 1) for v in team.NORM_STATS[\"imagenet\"])\n",
    "    parts, concepts = [], []\n",
    "    for step, images in enumerate(loader, 1):\n",
    "        if perturb is not None:\n",
    "            images = (perturb(images * std + mean) - mean) / std\n",
    "        scores, (crop_logits, disease_logits) = score_images(model, images.to(DEVICE), pairs)\n",
    "        scores = scores.cpu()\n",
    "        if perturb is None:\n",
    "            concepts.append(torch.stack((crop_logits.argmax(1), disease_logits.argmax(1)), dim=1).cpu())\n",
    "        if scores.shape != (len(images), len(pairs)) or not torch.isfinite(scores).all():\n",
    "            raise ValueError(\"Unexpected official candidate predictions.\")\n",
    "        parts.append(scores)\n",
    "        if step == 1 or step % 50 == 0 or step == len(loader):\n",
    "            print(f\"{split}: batch {step}/{len(loader)}\", flush=True)\n",
    "    return torch.cat(parts), torch.cat(concepts) if concepts else None\n",
    "\n",
    "\n",
    "\n",
    "def predict_recipe(recipe, run, pairs, filenames):\n",
    "    saved = torch.load(CHECKPOINT_DIR / \"model.pt\", map_location=\"cpu\", weights_only=True)\n",
    "    for key in (\"settings\", \"recipe\", \"recipe_spec\", \"feature_swapping\", \"selection\", \"gamma\", \"seen_pairs\", \"refit\"):\n",
    "        if saved[key] != run[key]:\n",
    "            raise RuntimeError(f\"Checkpoint and selection lock differ for {recipe}: {key}.\")\n",
    "    model = build_network(saved[\"recipe_spec\"], pretrained=False)\n",
    "    model.load_state_dict(saved[\"state_dict\"], strict=True)\n",
    "    model = model.to(DEVICE).eval()\n",
    "    boundary = len(train_pairs)\n",
    "    membership = torch.arange(len(pairs)) < boundary\n",
    "    clean, heads = zip(*(predict_official(model, pairs, names, split)\n",
    "                         for names, split in zip(filenames, (\"seen\", \"unseen\"))))\n",
    "    perturbed = {}\n",
    "    with torch.random.fork_rng(devices=[]):\n",
    "        torch.random.default_generator.manual_seed(team.SEED)\n",
    "        for condition, transform in PERTURBATIONS.items():\n",
    "            perturbed[condition], _ = predict_official(model, pairs, filenames[0], condition, transform)\n",
    "\n",
    "    predictions = {}\n",
    "    for rule, gamma in ((\"raw\", 0.0), (\"calibrated\", run[\"gamma\"])):\n",
    "        seen_scores, unseen_scores = (scores - gamma * membership for scores in clean)\n",
    "        predictions[rule] = {\n",
    "            \"gamma\": gamma,\n",
    "            \"seen\": top_predictions(seen_scores),\n",
    "            \"unseen\": top_predictions(unseen_scores),\n",
    "            \"seen_only\": top_predictions(seen_scores[:, :boundary]),\n",
    "            \"unseen_only\": top_predictions(unseen_scores[:, boundary:], offset=boundary),\n",
    "            \"robust\": {name: (scores - gamma * membership).topk(1, dim=1).indices\n",
    "                       for name, scores in perturbed.items()},\n",
    "        }\n",
    "\n",
    "    return predictions, clean, heads\n",
    "\n",
    "\n",
    "def score_trial(run, pairs, forward_pass, y_seen, y_unseen):\n",
    "    predictions, clean, (seen_heads, unseen_heads) = forward_pass\n",
    "    boundary = len(train_pairs)\n",
    "    y_all = torch.cat((y_seen, y_unseen))\n",
    "\n",
    "    reports, ranking, per_pair, robustness, restricted = [], [], [], [], []\n",
    "    # Rows are unseen images and columns are candidate pairs.\n",
    "    true_crop = pairs[y_unseen, 0]\n",
    "    same_crop_candidates = true_crop[:, None].eq(pairs[None, :, 0])\n",
    "    seen_head_hits = seen_heads.eq(pairs[y_seen])\n",
    "    unseen_head_hits = unseen_heads.eq(pairs[y_unseen])\n",
    "    head_top1 = {\n",
    "        f\"{split}_{head}_evidence_top1\": round(100 * matches[:, col].float().mean().item(), 2)\n",
    "        for split, matches in ((\"seen\", seen_head_hits), (\"unseen\", unseen_head_hits))\n",
    "        for col, head in enumerate((\"crop\", \"disease\"))\n",
    "    }\n",
    "    for name, prediction in predictions.items():\n",
    "        gamma = prediction[\"gamma\"]\n",
    "        raw_scores = clean[1]\n",
    "        crop_oracle = raw_scores.masked_fill(~same_crop_candidates, -torch.inf).topk(1, dim=1).indices\n",
    "        raw_margins = raw_scores.gather(1, y_unseen[:, None]).squeeze(1) - raw_scores[:, :boundary].amax(dim=1)\n",
    "        final_margins = raw_margins + gamma\n",
    "        only_correct = prediction[\"unseen_only\"][1].squeeze(1).eq(y_unseen)\n",
    "        metrics = {\"scoring\": name, \"gamma\": gamma, \"feature_swapping\": run[\"feature_swapping\"],\n",
    "                   \"selected_on_tune\": run[\"recipe\"] == plan[\"recipe_selected_on_tune\"],\n",
    "                   \"epoch\": run[\"selection\"][\"epoch\"], \"candidates\": len(pairs), **head_top1,\n",
    "                   \"raw_true_crop_candidate_top1\": prediction_accuracy(crop_oracle, y_unseen)}\n",
    "        for k in (1, 5):\n",
    "            metrics[f\"seen_top{k}\"] = prediction_accuracy(prediction[\"seen\"][k], y_seen)\n",
    "            metrics[f\"unseen_top{k}\"] = prediction_accuracy(prediction[\"unseen\"][k], y_unseen)\n",
    "            joined = torch.cat((prediction[\"seen\"][k], prediction[\"unseen\"][k]))\n",
    "            metrics[f\"overall_top{k}\"] = prediction_accuracy(joined, y_all)\n",
    "        metrics[\"harmonic_mean\"] = harmonic_mean(metrics[\"seen_top1\"], metrics[\"unseen_top1\"])\n",
    "        metrics[\"abs_seen_unseen_gap_pp\"] = round(abs(metrics[\"seen_top1\"] - metrics[\"unseen_top1\"]), 2)\n",
    "        seen_winner, unseen_winner = (prediction[split][1].squeeze(1) for split in (\"seen\", \"unseen\"))\n",
    "        metrics[\"seen_predicted_unseen\"] = int((seen_winner >= boundary).sum())\n",
    "        for split, winner, target in ((\"seen\", seen_winner, y_seen), (\"unseen\", unseen_winner, y_unseen)):\n",
    "            concept_hits = pairs[winner].eq(pairs[target]).float().mean(dim=0) * 100\n",
    "            metrics[f\"{split}_test_crop_acc\"], metrics[f\"{split}_test_disease_acc\"] = [\n",
    "                round(float(value), 2) for value in concept_hits]\n",
    "        reports.append(metrics)\n",
    "\n",
    "        correct = unseen_winner.eq(y_unseen)\n",
    "        predicts_seen = unseen_winner < boundary\n",
    "        blocked = only_correct & predicts_seen\n",
    "        same_crop = pairs[unseen_winner, 0].eq(pairs[y_unseen, 0])\n",
    "        ranking.append({\"scoring\": name, \"unseen_images\": len(y_unseen), \"joint_correct\": int(correct.sum()),\n",
    "                        \"unseen_only_correct\": int(only_correct.sum()), \"unseen_predicted_seen\": int(predicts_seen.sum()),\n",
    "                        \"blocked_by_seen\": int(blocked.sum()), \"blocked_same_crop\": int((blocked & same_crop).sum()),\n",
    "                        \"blocked_other_crop\": int((blocked & ~same_crop).sum()),\n",
    "                        \"median_true_pair_minus_top_seen_score\": float(final_margins.median())})\n",
    "        for index in range(boundary, len(pairs)):\n",
    "            mask = y_unseen.eq(index)\n",
    "            crop, disease = pairs[index].tolist()\n",
    "            per_pair.append({\"scoring\": name, \"crop\": crop, \"disease\": disease, \"support\": int(mask.sum()),\n",
    "                             \"joint_correct\": int((mask & correct).sum()),\n",
    "                             \"unseen_only_correct\": int((mask & only_correct).sum()),\n",
    "                             \"blocked_by_seen\": int((mask & blocked).sum())})\n",
    "        for key, predictions_at_one in prediction[\"robust\"].items():\n",
    "            accuracy = prediction_accuracy(predictions_at_one, y_seen)\n",
    "            robustness.append({\"scoring\": name, \"condition\": key, \"seen_top1\": accuracy,\n",
    "                               \"drop_pp\": round(metrics[\"seen_top1\"] - accuracy, 2)})\n",
    "        for split, targets, count in ((\"seen_only\", y_seen, boundary),\n",
    "                (\"unseen_only\", y_unseen, len(pairs) - boundary)):\n",
    "            restricted.append({\"scoring\": name, \"split\": split, \"candidates\": count,\n",
    "                               **{f\"top{k}\": prediction_accuracy(prediction[split][k], targets) for k in (1, 5)}})\n",
    "    return ({\"results\": reports, \"restricted_candidates\": restricted, \"robustness\": robustness,\n",
    "             \"unseen_ranking_diagnostics\": ranking, \"unseen_per_pair\": per_pair},\n",
    "            {name: pred[\"seen\"][1].squeeze(1) for name, pred in predictions.items()})\n",
    "\n",
    "\n",
    "def official_evaluation():\n",
    "    if DEBUG or winner_run is None:\n",
    "        raise RuntimeError(\"Complete the selected model's full refit before official evaluation.\")\n",
    "    recipe = plan[\"recipe_selected_on_tune\"]\n",
    "    if read_final_lock(recipe) != winner_run:\n",
    "        raise RuntimeError(\"The refitted checkpoint differs from the selected lock.\")\n",
    "    pairs = official_vocabulary()\n",
    "    paths = (team.TEST_SEEN_CSV, team.TEST_UNSEEN_CSV)\n",
    "    filenames = tuple(official_filenames(path) for path in paths)\n",
    "    seen_names, unseen_names = map(set, filenames)\n",
    "    if seen_names & unseen_names or set(train_full.image) & (seen_names | unseen_names):\n",
    "        raise ValueError(\"Training and official split filenames overlap.\")\n",
    "    predictions = predict_recipe(recipe, winner_run, pairs, filenames)\n",
    "    rows = {tuple(pair): i for i, pair in enumerate(pairs.tolist())}\n",
    "    y_seen = official_targets(paths[0], filenames[0], rows, seen=True)\n",
    "    y_unseen = official_targets(paths[1], filenames[1], rows, seen=False)\n",
    "    report, predicted_seen = score_trial(winner_run, pairs, predictions, y_seen, y_unseen)\n",
    "    summary = {\"selection\": winner_run, \"recipe_selected_on_tune\": recipe,\n",
    "               \"samples\": {\"seen\": len(y_seen), \"unseen\": len(y_unseen)},\n",
    "               \"pair_order\": \"train_then_concept_ids\", \"candidate_pairs\": pairs.tolist()}\n",
    "    for key, values in report.items():\n",
    "        summary[key] = [{\"recipe\": recipe, **row} for row in values]\n",
    "    winners = {f\"{recipe}_{rule}\": values for rule, values in predicted_seen.items()}\n",
    "    return summary, winners, y_seen\n",
    "\n",
    "\n",
    "evaluation = None if DEBUG else official_evaluation()"
   ],
