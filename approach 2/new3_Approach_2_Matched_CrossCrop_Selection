   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def make_model(spec):\n",
    "    return build_network(spec, pretrained=True).to(DEVICE).eval()\n",
    "\n",
    "\n",
    "def make_loader(frame, transform, shuffle):\n",
    "    return DataLoader(PlantDataset(frame, transform, \"imagenet\"), batch_size=BATCH_SIZE,\n",
    "                      shuffle=shuffle, num_workers=team.NUM_WORKERS, drop_last=False,\n",
    "                      generator=torch.Generator().manual_seed(team.SEED))\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def add_blur_view(backbone, images, features, generator):\n",
    "    selected = (torch.rand(len(images), generator=generator) < BLUR_PROB).to(images.device)\n",
    "    if selected.any():\n",
    "        blurred = TF.gaussian_blur(images[selected], kernel_size=[5, 5], sigma=[BLUR_SIGMA, BLUR_SIGMA])\n",
    "        features[selected] = backbone(blurred)\n",
    "    return features\n",
    "\n",
    "\n",
    "def train_epoch(model, optimizer, criterion, loader, objective, recipe, stage, epoch, epochs, blur_rng):\n",
    "    loss_total, samples, valid_anchors, swapped_anchors = 0., 0, 0, 0\n",
    "    for step, (images, crop, disease, pair_rows) in enumerate(loader, 1):\n",
    "        images, crop, disease = (batch.to(DEVICE) for batch in (images, crop, disease))\n",
    "        with torch.no_grad():\n",
    "            features = model.backbone(images)\n",
    "            if RECIPES[recipe][\"blur\"]:\n",
    "                features = add_blur_view(model.backbone, images, features, blur_rng)\n",
    "        loss, anchors, swaps = objective(model, criterion, features, crop, disease, pair_rows.to(DEVICE))\n",
    "        if not torch.isfinite(loss):\n",
    "            raise FloatingPointError(f\"Non-finite loss in {recipe}.\")\n",
    "        optimizer.zero_grad(set_to_none=True)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        loss_total += loss.item() * len(images)\n",
    "        samples += len(images)\n",
    "        valid_anchors += int(anchors)\n",
    "        swapped_anchors += int(swaps)\n",
    "        if step == 1 or step % 50 == 0 or step == len(loader):\n",
    "            print(f\"{recipe} {stage} epoch {epoch}/{epochs} · batch {step}/{len(loader)}\", flush=True)\n",
    "    if samples != len(loader.dataset):\n",
    "        raise RuntimeError(\"The fit loader did not process all intended images.\")\n",
    "    return {\"epoch\": epoch, \"images_trained\": samples,\n",
    "            \"train_loss\": loss_total / samples, \"supcon_anchor_fraction\": valid_anchors / samples,\n",
    "            \"swapped_anchor_fraction\": swapped_anchors / samples}\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def cache_development_features(backbone, groups):\n",
    "    cache = {}\n",
    "    for name, loader in groups.items():\n",
    "        features, labels = [], []\n",
    "        for images, _, _, targets in loader:\n",
    "            features.append(backbone(images.to(DEVICE)).cpu())\n",
    "            labels.append(targets)\n",
    "        cache[name] = torch.cat(features), torch.cat(labels)\n",
    "    return cache\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def development_scores(model, group):\n",
    "    features, labels = group\n",
    "    scores = [score_features(model, batch.to(DEVICE), train_pairs)[0].cpu()\n",
    "              for batch in features.split(BATCH_SIZE)]\n",
    "    return torch.cat(scores), labels\n",
    "\n",
    "\n",
    "def calibration_metrics(seen, proxy, fit_mask, gamma):\n",
    "    seen_scores, y_seen = seen\n",
    "    proxy_scores, y_proxy = proxy\n",
    "    seen_scores = seen_scores - gamma * fit_mask\n",
    "    proxy_scores = proxy_scores - gamma * fit_mask\n",
    "    seen_top1 = top_k_accuracy(seen_scores, y_seen, 1)\n",
    "    proxy_top1 = top_k_accuracy(proxy_scores, y_proxy, 1)\n",
    "    return {\"gamma\": gamma, \"seen_top1\": seen_top1, \"proxy_top1\": proxy_top1,\n",
    "            \"seen_top5\": top_k_accuracy(seen_scores, y_seen, 5),\n",
    "            \"proxy_top5\": top_k_accuracy(proxy_scores, y_proxy, 5),\n",
    "            \"harmonic_top1\": harmonic_mean(seen_top1, proxy_top1)}\n",
    "\n",
    "\n",
    "def selection_key(row):\n",
    "    return row[\"harmonic_top1\"], row[\"proxy_top1\"], row[\"seen_top1\"], -row[\"epoch\"]\n",
    "\n",
    "\n",
    "def snapshot_trainable(model):\n",
    "    return {name: param.detach().cpu().clone()\n",
    "            for name, param in model.named_parameters() if param.requires_grad}\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def restore_trainable(model, state):\n",
    "    for name, param in model.named_parameters():\n",
    "        if param.requires_grad:\n",
    "            param.copy_(state[name])\n",
    "\n",
    "\n",
    "def develop_recipe(recipe, spec, fit, fit_transform, groups, fit_mask):\n",
    "    team.set_seed()\n",
    "    model = make_model(spec)\n",
    "    team.set_seed()\n",
    "    fit_loader = make_fit_loader(fit, fit_transform, spec)\n",
    "    blur_rng = torch.Generator().manual_seed(team.SEED + 172)\n",
    "    optimizer = torch.optim.AdamW((p for p in model.parameters() if p.requires_grad),\n",
    "                                  lr=HEAD_LR, weight_decay=WEIGHT_DECAY)\n",
    "    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS)\n",
    "    criterion = nn.CrossEntropyLoss(label_smoothing=SMOOTHING)\n",
    "    objective = training_objective(spec, fit)\n",
    "    history, best, best_weights, best_scores = [], None, None, None\n",
    "    for epoch in range(1, EPOCHS + 1):\n",
    "        row = {\"recipe\": recipe, \"feature_swapping\": spec[\"swap\"],\n",
    "               **train_epoch(model, optimizer, criterion, fit_loader, objective, recipe, \"development\", epoch, EPOCHS, blur_rng)}\n",
    "        scheduler.step()\n",
    "        if not DEBUG:\n",
    "            tune = [development_scores(model, groups[key]) for key in (\"tune_seen\", \"tune_proxy\")]\n",
    "            row.update(calibration_metrics(*tune, fit_mask, 0.))\n",
    "            if best is None or selection_key(row) > selection_key(best):\n",
    "                best = row.copy()\n",
    "                best_weights = snapshot_trainable(model)\n",
    "                best_scores = tune\n",
    "        history.append(row)\n",
    "        print(row, flush=True)\n",
    "\n",
    "    output = DEVELOPMENT_DIR / recipe\n",
    "    output.mkdir(parents=True, exist_ok=True)\n",
    "    pd.DataFrame(history).to_csv(output / \"training_history.csv\", index=False)\n",
    "    if DEBUG:\n",
    "        return None\n",
    "    if spec[\"swap\"] and not any(row[\"swapped_anchor_fraction\"] > 0 for row in history):\n",
    "        raise RuntimeError(\"Feature recombination requires fit images sharing a disease across crops.\")\n",
    "\n",
    "    grid = [calibration_metrics(*best_scores, fit_mask, gamma) for gamma in GAMMAS]\n",
    "    gamma = max(grid, key=lambda row: (row[\"harmonic_top1\"], row[\"proxy_top1\"],\n",
    "                                       row[\"seen_top1\"], -row[\"gamma\"]))[\"gamma\"]\n",
    "    restore_trainable(model, best_weights)\n",
    "    check = [development_scores(model, groups[key]) for key in (\"check_seen\", \"check_proxy\")]\n",
    "    check_rows = [{\"recipe\": recipe, \"scoring\": rule, **calibration_metrics(*check, fit_mask, penalty)}\n",
    "                  for rule, penalty in ((\"raw\", 0.), (\"calibrated\", gamma))]\n",
    "    pd.DataFrame(grid).to_csv(output / \"calibration_tune_grid.csv\", index=False)\n",
    "    pd.DataFrame(check_rows).to_csv(output / \"calibration_check.csv\", index=False)\n",
    "    return {\"selection\": best, \"gamma\": gamma, \"independent_check\": check_rows,\n",
    "            \"trainable_parameter_count\": sum(p.numel() for p in model.parameters() if p.requires_grad)}\n",
    "\n",
    "\n",
    "def run_development():\n",
    "    DEVELOPMENT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "    atomic_json(DEVELOPMENT_DIR / \"environment.json\", environment)\n",
    "    (DEVELOPMENT_DIR / \"requirements.txt\").write_bytes(requirements_bytes)\n",
    "    team.set_seed()\n",
    "    train, val, seen, unseen = get_loaders(BATCH_SIZE, norm=\"imagenet\", debug=DEBUG)\n",
    "    if seen is not None or unseen is not None:\n",
    "        raise RuntimeError(\"Development loaders must use the training CSV only.\")\n",
    "    fit = train.dataset.frame.copy()\n",
    "    fit[\"image\"] = fit.image.map(image_key)\n",
    "    fit_mask, frames, groups = None, {}, {}\n",
    "    if not DEBUG:\n",
    "        fit_mask, frames = calibration_split(fit, val.dataset.frame)\n",
    "        fit = fit.loc[fit.pair_row.isin(torch.where(fit_mask)[0].tolist())]\n",
    "        group_loaders = {key: make_loader(frame, image_transform, shuffle=False)\n",
    "                         for key, frame in frames.items()}\n",
    "        reference_model = make_model(RECIPES[\"A2_Add_SupCon\"])\n",
    "        print(\"Caching frozen DINOv2 features for the four development groups.\", flush=True)\n",
    "        groups = cache_development_features(reference_model.backbone, group_loaders)\n",
    "        del reference_model\n",
    "\n",
    "    selections = {recipe: develop_recipe(recipe, spec, fit, train.dataset.transform, groups, fit_mask)\n",
    "                  for recipe, spec in RECIPES.items()}\n",
    "    if DEBUG:\n",
    "        return None\n",
    "    chosen = max(selections, key=lambda recipe: selection_key(selections[recipe][\"selection\"]))\n",
    "    plan = {\"recipe_selected_on_tune\": chosen, \"recipes\": selections, \"settings\": settings,\n",
    "            \"fit_images\": len(fit), \"fit_pair_rows\": torch.where(fit_mask)[0].tolist(),\n",
    "            \"tune_pair_rows\": sorted(frames[\"tune_proxy\"].pair_row.unique().tolist()),\n",
    "            \"check_pair_rows\": sorted(frames[\"check_proxy\"].pair_row.unique().tolist())}\n",
    "    atomic_json(DEVELOPMENT_DIR / \"selection_plan.json\", plan)\n",
    "    table = pd.DataFrame([{**value[\"selection\"], \"locked_gamma\": value[\"gamma\"],\n",
    "                           \"selected_on_tune\": recipe == chosen}\n",
    "                          for recipe, value in selections.items()])\n",
    "    table.to_csv(DEVELOPMENT_DIR / \"selected_models.csv\", index=False)\n",
    "    deltas = []\n",
    "    for recipe, reference in COMPARE_TO.items():\n",
    "        trial, control = (selections[key] for key in (recipe, reference))\n",
    "        for split, left, right in ((\"tune\", trial[\"selection\"], control[\"selection\"]),\n",
    "                                   (\"check\", trial[\"independent_check\"][0], control[\"independent_check\"][0])):\n",
    "            deltas.append({\"recipe\": recipe, \"reference\": reference, \"split\": split,\n",
    "                           **{f\"{metric}_delta_pp\": round(left[metric] - right[metric], 2)\n",
