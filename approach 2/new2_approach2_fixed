    "def image_key(value):\n",
    "    result = Path(str(value).strip().replace(\"\\\\\", \"/\"))\n",
    "    if not result.name or result.is_absolute() or \"..\" in result.parts or \":\" in str(result):\n",
    "        raise ValueError(f\"Expected a relative image filename, got {value!r}.\")\n",
    "    return result.as_posix()\n",
    "\n",
    "\n",
    "def sha256_file(path):\n",
    "    with path.open(\"rb\") as stream:\n",
    "        return hashlib.file_digest(stream, \"sha256\").hexdigest()\n",
    "\n",
    "\n",
    "def atomic_json(path, value):\n",
    "    temp = path.with_suffix(\".json.tmp\")\n",
    "    temp.write_text(json.dumps(value, indent=2), encoding=\"utf-8\")\n",
    "    temp.replace(path)\n",
    "\n",
    "\n",
    "def atomic_save(path, value):\n",
    "    temp = path.with_suffix(\".pt.tmp\")\n",
    "    torch.save(value, temp)\n",
    "    temp.replace(path)\n",
    "\n",
    "\n",
    "train_full = load_split(cfg.TRAIN_CSV)\n",
    "train_full[\"image\"] = train_full.image.map(image_key)\n",
    "if not train_full.image.is_unique:\n",
    "    raise ValueError(\"Duplicate training images.\")\n",
    "train_pairs = get_pairs()\n",
    "if train_pairs.shape != (cfg.NUM_SEEN_PAIRS, 2):\n",
    "    raise ValueError(\"Unexpected training pair table.\")\n",
    "_, image_transform = get_transforms(HP[\"norm\"])\n",
    "\n",
    "\n",
    "def calibration_split(fit_frame, val_frame):\n",
    "    \"\"\"Hold out complete training pairs from the development training.\"\"\"\n",
    "    grouped = fit_frame.groupby(\"pair_row\", sort=True)\n",
    "    rows = grouped.agg(n=(\"image\", \"size\"), crop=(\"crop\", \"first\"), disease=(\"disease\", \"first\"))\n",
    "    crops = rows.crop.value_counts().to_dict()\n",
    "    diseases = rows.disease.value_counts().to_dict()\n",
    "    eligible = rows[rows.n.ge(5)].sample(frac=1, random_state=cfg.SEED + 1)\n",
    "    held = []\n",
    "    for pair_row, row in eligible.iterrows():\n",
    "        if crops[row.crop] > 1 and diseases[row.disease] > 1:\n",
    "            held.append(int(pair_row))\n",
    "            crops[row.crop] -= 1\n",
    "            diseases[row.disease] -= 1\n",
    "        if len(held) == 10:\n",
    "            break\n",
    "    if len(held) < 10:\n",
    "        raise ValueError(\"Ten train-derived holdouts with fit support were not available.\")\n",
    "    seen = val_frame.loc[~val_frame.pair_row.isin(held)].sample(frac=1, random_state=cfg.SEED + 2)\n",
    "    cut = len(seen) // 2\n",
    "    frames = {\n",
    "        \"tune_seen\": seen.iloc[:cut],\n",
    "        \"tune_proxy\": train_full.loc[train_full.pair_row.isin(held[:5])],\n",
    "        \"check_seen\": seen.iloc[cut:],\n",
    "        \"check_proxy\": train_full.loc[train_full.pair_row.isin(held[5:])],\n",
    "    }\n",
    "    if any(group.empty for group in frames.values()):\n",
    "        raise ValueError(\"Calibration needs both seen and proxy images in each group.\")\n",
    "    fit_mask = torch.ones(len(train_pairs), dtype=torch.bool)\n",
    "    fit_mask[held] = False\n",
    "    return fit_mask, frames\n",
    "\n",
    "\n",
    "settings = {\n",
    "    \"hp\": HP.copy(), \"debug\": DEBUG, \"image_size\": cfg.IMAGE_SIZE, \"resize_size\": cfg.RESIZE_SIZE,\n",
    "    \"lambda_grid\": LAMBDAS, \"gamma_grid\": GAMMAS, \"train_csv_sha256\": sha256_file(cfg.TRAIN_CSV),\n",
    "    \"selection\": \"raw_tune_harmonic_mean\", \"prototype_transform\": \"deterministic_eval_transform\",\n",
    "}\n"
