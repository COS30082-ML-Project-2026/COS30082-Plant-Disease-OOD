    "class CosineHead(nn.Module):\n",
    "    \"\"\"Cosine classifier shared between training (AM-Softmax) and inference (log-softmax).\"\"\"\n",
    "    def __init__(self, proj_dim, n_classes):\n",
    "        super().__init__()\n",
    "        self.weight = nn.Parameter(torch.randn(n_classes, proj_dim))\n",
    "        nn.init.xavier_uniform_(self.weight)\n",
    "\n",
    "    def cosine_logits(self, feats):\n",
    "        return F.normalize(feats, dim=-1) @ F.normalize(self.weight, dim=-1).T  # [B, C]\n",
    "\n",
    "    def am_loss(self, feats, labels, margin, scale):\n",
    "        cos = self.cosine_logits(feats)\n",
    "        one_hot = F.one_hot(labels, num_classes=self.weight.size(0)).float()\n",
    "        target = cos - margin * one_hot\n",
    "        return F.cross_entropy(scale * target, labels)\n",
    "\n",
    "\n",
    "class HybridModel(nn.Module):\n",
    "    def __init__(self, proj_dim, *, pretrained):\n",
    "        super().__init__()\n",
    "        self.backbone = timm.create_model(MODEL, pretrained=pretrained, num_classes=0, img_size=cfg.IMAGE_SIZE)\n",
    "        self.backbone.requires_grad_(False)\n",
    "        feat_dim = self.backbone.num_features\n",
    "        self.proj = nn.Sequential(\n",
    "            nn.Linear(feat_dim, proj_dim),\n",
    "            nn.GELU(),\n",
    "            nn.LayerNorm(proj_dim),\n",
    "        )\n",
    "        self.crop_head = CosineHead(proj_dim, cfg.NUM_CROPS)\n",
    "        self.disease_head = CosineHead(proj_dim, cfg.NUM_DISEASES)\n",
    "        self.register_buffer('crop_proto', torch.zeros(cfg.NUM_CROPS, proj_dim))\n",
    "        self.register_buffer('global_disease_proto', torch.zeros(cfg.NUM_DISEASES, proj_dim))\n",
    "        self.register_buffer('crop_disease_proto', torch.zeros(cfg.NUM_CROPS, cfg.NUM_DISEASES, proj_dim))\n",
    "        self.register_buffer('crop_disease_mask', torch.zeros(cfg.NUM_CROPS, cfg.NUM_DISEASES, dtype=torch.bool))\n",
    "\n",
    "    def forward(self, images):\n",
    "        with torch.no_grad():\n",
    "            raw = self.backbone(images).float()\n",
    "        return self.proj(raw)\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def build_prototypes(model, loader):\n",
    "    \"\"\"Rebuild prototypes from projected features (the ones training actually updates).\"\"\"\n",
    "    model.eval()\n",
    "    D = model.crop_proto.shape[1]\n",
    "    crop_sum = torch.zeros(cfg.NUM_CROPS, D, device=device)\n",
    "    crop_cnt = torch.zeros(cfg.NUM_CROPS, device=device)\n",
    "    dis_sum = torch.zeros(cfg.NUM_DISEASES, D, device=device)\n",
    "    dis_cnt = torch.zeros(cfg.NUM_DISEASES, device=device)\n",
    "    cd_sum = torch.zeros(cfg.NUM_CROPS, cfg.NUM_DISEASES, D, device=device)\n",
    "    cd_cnt = torch.zeros(cfg.NUM_CROPS, cfg.NUM_DISEASES, device=device)\n",
    "\n",
    "    flat_sum = cd_sum.reshape(-1, D)\n",
    "    flat_count = cd_cnt.view(-1)\n",
    "    for images, crop_lbl, dis_lbl, _ in loader:\n",
    "        feats = model(images.to(device))\n",
    "        crop_lbl = crop_lbl.to(device); dis_lbl = dis_lbl.to(device)\n",
    "        crop_sum.index_add_(0, crop_lbl, feats)\n",
    "        crop_cnt.index_add_(0, crop_lbl, torch.ones_like(crop_lbl, dtype=torch.float))\n",
    "        dis_sum.index_add_(0, dis_lbl, feats)\n",
    "        dis_cnt.index_add_(0, dis_lbl, torch.ones_like(dis_lbl, dtype=torch.float))\n",
    "        pair_ids = crop_lbl * cfg.NUM_DISEASES + dis_lbl\n",
    "        flat_sum.index_add_(0, pair_ids, feats)\n",
    "        flat_count.index_add_(0, pair_ids, torch.ones_like(pair_ids, dtype=flat_count.dtype))\n",
    "\n",
    "    model.crop_proto.copy_(crop_sum / crop_cnt.clamp_min(1).unsqueeze(1))\n",
    "    model.global_disease_proto.copy_(dis_sum / dis_cnt.clamp_min(1).unsqueeze(1))\n",
    "    model.crop_disease_proto.copy_(cd_sum / cd_cnt.clamp_min(1).unsqueeze(-1))\n",
    "    model.crop_disease_mask.copy_(cd_cnt > 0)\n",
    "    model.crop_proto.copy_(F.normalize(model.crop_proto, dim=1))\n",
    "    model.global_disease_proto.copy_(F.normalize(model.global_disease_proto, dim=1))\n",
    "    normed = F.normalize(model.crop_disease_proto, dim=-1)\n",
    "    model.crop_disease_proto.copy_(\n",
    "        torch.where(model.crop_disease_mask.unsqueeze(-1), normed, model.crop_disease_proto))\n",
    "    return int(model.crop_disease_mask.sum().item())\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def pair_score_parts(model, feats, pairs, scale):\n",
    "    \"\"\"Return additive cosine-classifier, global prototype, and conditional prototype scores.\"\"\"\n",
    "    crop_ids, disease_ids = pairs.to(feats.device).unbind(1)\n",
    "    crop = F.log_softmax(scale * model.crop_head.cosine_logits(feats), dim=1)\n",
    "    disease = F.log_softmax(scale * model.disease_head.cosine_logits(feats), dim=1)\n",
    "    linear = crop[:, crop_ids] + disease[:, disease_ids]\n",
    "\n",
    "    features = F.normalize(feats, dim=1)\n",
    "    crop_similarity = features @ model.crop_proto[crop_ids].T\n",
    "    global_bank = model.global_disease_proto[disease_ids]\n",
    "    conditional_bank = torch.where(model.crop_disease_mask[crop_ids, disease_ids, None],\n",
    "                                   model.crop_disease_proto[crop_ids, disease_ids], global_bank)\n",
    "    return linear, crop_similarity + features @ global_bank.T, crop_similarity + features @ conditional_bank.T\n"
   ]
  },
