    "def save_locked_model(development):\n",
    "    metadata, state = development\n",
    "    if sha256_file(cfg.TRAIN_CSV) != settings[\"train_csv_sha256\"]:\n",
    "        raise RuntimeError(\"The training CSV changed during development.\")\n",
    "    CHECKPOINT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "    FINAL_DIR.mkdir(parents=True, exist_ok=True)\n",
    "    if LOCK.is_file():\n",
    "        raise FileExistsError(\"The current run is already locked.\")\n",
    "    atomic_save(CHECKPOINT, {\"state_dict\": state, \"metadata\": metadata})\n",
    "    lock = {**metadata, \"checkpoint_sha256\": sha256_file(CHECKPOINT)}\n",
    "    atomic_json(LOCK, lock)\n",
    "    print(\"Locked model and prototype bank:\", CHECKPOINT)\n",
    "    return lock\n",
    "\n",
    "\n",
    "def load_locked_model():\n",
    "    lock = json.loads(LOCK.read_text(encoding=\"utf-8\"))\n",
    "    if sha256_file(CHECKPOINT) != lock[\"checkpoint_sha256\"]:\n",
    "        raise RuntimeError(\"The checkpoint changed after the evaluation rule was locked.\")\n",
    "    if sha256_file(cfg.TRAIN_CSV) != lock[\"settings\"][\"train_csv_sha256\"] or lock[\"seen_pairs\"] != train_pairs.tolist():\n",
    "        raise RuntimeError(\"The training candidates changed after selection.\")\n",
    "    saved = torch.load(CHECKPOINT, map_location=\"cpu\", weights_only=True)\n",
    "    if saved[\"metadata\"] != {name: value for name, value in lock.items() if name != \"checkpoint_sha256\"}:\n",
    "        raise RuntimeError(\"Saved checkpoint and evaluation settings differ.\")\n",
    "    model = make_model(pretrained=False, hp=lock[\"settings\"][\"hp\"])\n",
    "    model.load_state_dict(saved[\"state_dict\"], strict=True)\n",
    "    return model.eval(), lock\n",
    "\n",
    "\n",
    "locked = None if DEBUG else save_locked_model(development)\n"
