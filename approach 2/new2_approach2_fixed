  {
   "cell_type": "code",
   "execution_count": null,
   "id": "hybrid-eval",
   "metadata": {},
   "outputs": [],
   "source": [
    "def official_vocabulary():\n",
    "    # The final shortlist uses only concept identities and discards per-image row order.\n",
    "    vocabulary = pd.read_csv(cfg.TEST_UNSEEN_CSV, header=None, usecols=[1, 2],\n",
    "                             dtype=str, keep_default_na=False)\n",
    "    vocabulary.columns = [\"crop\", \"disease\"]\n",
    "    if not vocabulary.empty and not vocabulary.iloc[0][\"crop\"].strip().isdigit():\n",
    "        vocabulary = vocabulary.iloc[1:]\n",
    "    vocabulary = (vocabulary.astype(\"int64\").drop_duplicates()\n",
    "                  .sort_values([\"crop\", \"disease\"]))\n",
    "    extra_pairs = torch.as_tensor(vocabulary.to_numpy(copy=True), dtype=torch.long)\n",
    "    pairs = torch.cat((train_pairs, extra_pairs))\n",
    "    if (len(extra_pairs) != cfg.NUM_UNSEEN_PAIRS or len(pairs.unique(dim=0)) != cfg.NUM_PAIRS\n",
    "            or not set(extra_pairs[:, 0].tolist()) <= set(train_pairs[:, 0].tolist())\n",
    "            or not set(extra_pairs[:, 1].tolist()) <= set(train_pairs[:, 1].tolist())):\n",
    "        raise ValueError(\"Expected distinct official unseen pairs composed of training-derived concepts.\")\n",
    "    return pairs\n",
    "\n",
    "\n",
    "def official_filenames(path):\n",
    "    values = pd.read_csv(path, header=None, usecols=[0], dtype=str, keep_default_na=False).iloc[:, 0].tolist()\n",
    "    header = {\"image\", \"image_path\", \"image_name\", \"filename\", \"file_name\", \"file_path\", \"path\"}\n",
    "    if values and (values[0].strip().lower().replace(\" \", \"_\") in header or\n",
    "                   (len(values) > 1 and not Path(values[0]).suffix and Path(values[1]).suffix)):\n",
    "        values = values[1:]\n",
    "    names = [image_key(name) for name in values]\n",
    "    if not names or len(set(names)) != len(names):\n",
    "        raise ValueError(f\"Expected unique image names in {path.name}.\")\n",
    "    return names\n",
    "\n",
    "\n",
    "class OfficialImages(Dataset):\n",
    "    def __init__(self, names):\n",
    "        self.names = names\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.names)\n",
    "\n",
    "    def __getitem__(self, index):\n",
    "        with Image.open(cfg.IMAGE_DIR / self.names[index]) as image:\n",
    "            return image_transform(image.convert(\"RGB\"))\n",
    "\n",
    "\n",
    "def official_targets(csv_path, filenames, row_by_pair, *, seen):\n",
    "    # This per-image projection is used after predictions. Ignore the official pair_label column.\n",
    "    frame = pd.read_csv(csv_path, header=None, usecols=[0, 1, 2], dtype=str, keep_default_na=False)\n",
    "    frame.columns = [\"image\", \"crop\", \"disease\"]\n",
    "    if not frame.empty and not frame.iloc[0][\"crop\"].strip().isdigit():\n",
    "        frame = frame.iloc[1:]\n",
    "    if frame.image.map(image_key).tolist() != filenames:\n",
    "        raise ValueError(\"Official targets and predictions have different image orders.\")\n",
    "    keys = frame[[\"crop\", \"disease\"]].astype(\"int64\").itertuples(index=False, name=None)\n",
    "    try:\n",
    "        labels = torch.tensor([row_by_pair[key] for key in keys], dtype=torch.long)\n",
    "    except KeyError as error:\n",
    "        raise ValueError(f\"Official ground-truth pair absent from the frozen candidate table: {error}\") from error\n",
    "    if not ((labels < cfg.NUM_SEEN_PAIRS) == seen).all():\n",
    "        raise ValueError(\"Official test split does not match seen membership.\")\n",
    "    return labels\n",
    "\n",
    "\n",
    "def top_predictions(scores, offset=0):\n",
    "    return {k: scores.topk(k, dim=1).indices + offset for k in (1, 5)}\n",
    "\n",
    "\n",
    "def prediction_accuracy(predictions, labels):\n",
    "    return round(100 * predictions.eq(labels[:, None]).any(1).float().mean().item(), 2)\n",
    "\n",
    "\n",
    "@torch.inference_mode()\n",
    "def predict_official(model, pairs, filenames, lock):\n",
    "    loader = DataLoader(OfficialImages(filenames), batch_size=lock[\"settings\"][\"hp\"][\"batch_size\"],\n",
    "                        shuffle=False, num_workers=0)\n",
    "    parts = []\n",
    "    for images in loader:\n",
    "        feats = model(images.to(device))\n",
    "        linear, _, conditional = pair_score_parts(model, feats, pairs, lock[\"settings\"][\"hp\"][\"am_scale\"])\n",
    "        lam = lock[\"selection\"][\"lambda\"]\n",
    "        scores = mix_branches((linear, None, conditional), lam)\n",
    "        if not torch.isfinite(scores).all():\n",
    "            raise ValueError(\"Final predictions contain non-finite scores.\")\n",
    "        parts.append(scores.cpu())\n",
    "    return torch.cat(parts)\n",
    "\n",
    "\n",
    "def final_evaluation():\n",
    "    if DEBUG:\n",
    "        raise RuntimeError(\"Run full development before official evaluation.\")\n",
    "    model, lock = load_locked_model()\n",
    "    if lock != locked:\n",
    "        raise RuntimeError(\"The loaded lock differs from the lock created in this run.\")\n",
    "    pairs = official_vocabulary()\n",
    "    paths = (cfg.TEST_SEEN_CSV, cfg.TEST_UNSEEN_CSV)\n",
    "    names = [official_filenames(path) for path in paths]\n",
    "    seen_names, unseen_names = map(set, names)\n",
    "    if seen_names & unseen_names or set(train_full.image) & (seen_names | unseen_names):\n",
    "        raise ValueError(\"Image filenames overlap across the official or training splits.\")\n",
    "\n",
    "    raw_scores = [predict_official(model, pairs, split, lock) for split in names]\n",
    "    membership = torch.arange(len(pairs)) < len(train_pairs)\n",
    "    predictions = {\n",
    "        mode: [top_predictions(apply_stacking(scores, membership, gamma)) for scores in raw_scores]\n",
    "        for mode, gamma in lock[\"rules\"].items()\n",
    "    }\n",
    "    # Attach per-image truth only after both modes have produced predictions.\n",
    "    lookup = {tuple(pair): i for i, pair in enumerate(pairs.tolist())}\n",
    "    seen_y = official_targets(paths[0], names[0], lookup, seen=True)\n",
    "    unseen_y = official_targets(paths[1], names[1], lookup, seen=False)\n",
    "    all_y = torch.cat((seen_y, unseen_y))\n",
    "    rows = []\n",
    "    for mode, (seen, unseen) in predictions.items():\n",
    "        row = {\"scoring\": mode, \"lambda\": lock[\"selection\"][\"lambda\"], \"gamma\": lock[\"rules\"][mode],\n",
    "               \"candidates\": len(pairs)}\n",
    "        for k in (1, 5):\n",
    "            row[f\"seen_top{k}\"] = prediction_accuracy(seen[k], seen_y)\n",
    "            row[f\"unseen_top{k}\"] = prediction_accuracy(unseen[k], unseen_y)\n",
    "            row[f\"overall_top{k}\"] = prediction_accuracy(torch.cat((seen[k], unseen[k])), all_y)\n",
    "        row[\"harmonic_mean_top1\"] = harmonic_mean(row[\"seen_top1\"], row[\"unseen_top1\"])\n",
    "        rows.append(row)\n",
    "\n",
    "    OFFICIAL_DIR.mkdir(parents=True, exist_ok=True)\n",
    "    width = len(pairs)\n",
    "    labels = list(range(width))\n",
    "    for mode, (seen, _) in predictions.items():\n",
    "        cells = seen_y * width + seen[1].squeeze(1)\n",
    "        cm = torch.bincount(cells, minlength=width * width).reshape(width, width).numpy()\n",
    "        name = \"seen_confusion_matrix.csv\" if mode == \"raw\" else \"seen_confusion_matrix_calibrated.csv\"\n",
    "        pd.DataFrame(cm, index=labels, columns=labels).to_csv(OFFICIAL_DIR / name)\n",
    "    table = pd.DataFrame(rows)\n",
    "    for mode, subset in table.groupby(\"scoring\", sort=False):\n",
    "        subset.to_csv(OFFICIAL_DIR / f\"official_{mode}_results.csv\", index=False)\n",
    "    report = {\"model\": MODEL_NAME, \"candidate_pairs\": pairs.tolist(),\n",
    "              \"candidate_order\": \"training_order_then_unseen_concept_id_order\",\n",
    "              \"samples\": {\"seen\": len(seen_y), \"unseen\": len(unseen_y)}, \"evaluation_lock\": lock,\n",
    "              \"raw_gamma0\": rows[0], \"calibrated\": rows[1]}\n",
    "    atomic_json(OFFICIAL_DIR / \"final_results.json\", report)\n",
    "    display(table)\n",
    "    print(\"Results:\", OFFICIAL_DIR)\n",
    "    return report\n",
    "\n",
    "\n",
    "report = None if DEBUG else final_evaluation()\n"
   ]
