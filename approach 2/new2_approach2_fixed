    "# 4. Development and checkpoint lock\n",
    "\n",
    "Select the epoch and hybrid weight `lambda` by raw harmonic mean on the tune set. Using that same checkpoint and prototype bank, select the seen-pair penalty `gamma` by the tune harmonic mean. Development subtracts gamma from fit-pair scores. The independent check reports both scoring modes and the cosine/prototype ablations.\n",
    "\n",
    "Checkpoint weights, prototypes, and scoring settings are locked together. The final run uses the exact selected fit checkpoint. The ten training-derived holdout combinations remain outside model fitting and prototype construction for this experiment."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "hybrid-train",
   "metadata": {},
   "outputs": [],
   "source": [
    "def train_one_epoch(model, optimizer, loader):\n",
    "    model.train()\n",
    "    model.backbone.eval()\n",
    "    total, count = 0.0, 0\n",
    "    for images, crop_lbl, dis_lbl, _ in loader:\n",
    "        images = images.to(device); crop_lbl = crop_lbl.to(device); dis_lbl = dis_lbl.to(device)\n",
    "        feats = model(images)                                      # grads flow: proj + heads\n",
    "        loss = model.crop_head.am_loss(feats, crop_lbl, HP['am_margin'], HP['am_scale'])\n",
    "        loss = loss + model.disease_head.am_loss(feats, dis_lbl, HP['am_margin'], HP['am_scale'])\n",
    "        optimizer.zero_grad(set_to_none=True)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        total += loss.item() * len(images); count += len(images)\n",
    "    return total / max(count, 1)\n",
    "\n",
    "\n",
    "def make_model(pretrained, hp):\n",
    "    return HybridModel(hp[\"proj_dim\"], pretrained=pretrained).to(device)\n",
    "\n",
    "\n",
    "def make_loader(frame, transform, *, shuffle=False):\n",
    "    return DataLoader(PlantDataset(frame, transform, HP[\"norm\"]), batch_size=HP[\"batch_size\"],\n",
    "                      shuffle=shuffle, num_workers=0, generator=torch.Generator().manual_seed(cfg.SEED))\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def score_groups(model, loaders):\n",
    "    scores = {}\n",
    "    for name, loader in loaders.items():\n",
    "        linear, global_proto, conditional, labels = [], [], [], []\n",
    "        for images, _, _, target in loader:\n",
    "            parts = pair_score_parts(model, model(images.to(device)), train_pairs, HP[\"am_scale\"])\n",
    "            for collection, value in zip((linear, global_proto, conditional), parts):\n",
    "                collection.append(value.cpu())\n",
    "            labels.append(target)\n",
    "        scores[name] = tuple(torch.cat(parts) for parts in (linear, global_proto, conditional, labels))\n",
    "    return scores\n",
    "\n",
    "\n",
    "def mix_branches(parts, lam, prototype_index=2):\n",
    "    return (1 - lam) * parts[0] + lam * parts[prototype_index]\n",
    "\n",
    "\n",
    "def apply_stacking(scores, membership, gamma):\n",
    "    if membership.ndim != 1 or membership.numel() != scores.size(1):\n",
    "        raise ValueError(\"Seen membership must align with the candidate table.\")\n",
    "    return scores - gamma * membership.to(device=scores.device, dtype=scores.dtype)\n",
    "\n",
    "\n",
    "def development_metrics(groups, split, membership, lam, gamma=0., prototype_index=2):\n",
    "    metrics = {}\n",
    "    for source in (\"seen\", \"proxy\"):\n",
    "        parts = groups[f\"{split}_{source}\"]\n",
    "        scores = apply_stacking(mix_branches(parts, lam, prototype_index), membership, gamma)\n",
    "        for k in (1, 5):\n",
    "            metrics[f\"{source}_top{k}\"] = top_k_accuracy(scores, parts[-1], k)\n",
    "    metrics[\"harmonic_top1\"] = harmonic_mean(metrics[\"seen_top1\"], metrics[\"proxy_top1\"])\n",
    "    return metrics\n",
    "\n",
    "\n",
    "def development_key(row):\n",
    "    return row[\"harmonic_top1\"], row[\"proxy_top1\"], row[\"seen_top1\"]\n",
    "\n",
    "\n",
    "def run_development():\n",
    "    cfg.set_seed(cfg.SEED)\n",
    "    tr, va, seen, unseen = get_loaders(HP[\"batch_size\"], norm=HP[\"norm\"], debug=DEBUG)\n",
    "    if seen is not None or unseen is not None:\n",
    "        raise RuntimeError(\"Train-only development requires the team's train-only loader.\")\n",
    "    fit = tr.dataset.frame\n",
    "    fit_mask, groups, frames = None, {}, {}\n",
    "    if not DEBUG:\n",
    "        fit_mask, frames = calibration_split(fit, va.dataset.frame)\n",
    "        allowed = fit_mask.nonzero(as_tuple=True)[0].tolist()\n",
    "        fit = fit.loc[fit.pair_row.isin(allowed)]\n",
    "        groups = {name: make_loader(frame, image_transform) for name, frame in frames.items()}\n",
    "    fit_loader = make_loader(fit, tr.dataset.transform, shuffle=True)\n",
    "    prototype_loader = make_loader(fit, image_transform)\n",
    "    model = make_model(pretrained=True, hp=HP)\n",
    "    optimizer = torch.optim.AdamW((p for p in model.parameters() if p.requires_grad),\n",
    "                                  lr=HP[\"lr\"], weight_decay=HP[\"weight_decay\"])\n",
    "    DEVELOPMENT_DIR.mkdir(parents=True, exist_ok=False)\n",
    "\n",
    "    history, selection_grid, best, best_state, best_tune = [], [], None, None, None\n",
    "    for epoch in range(1, HP[\"epochs\"] + 1):\n",
    "        loss = train_one_epoch(model, optimizer, fit_loader)\n",
    "        bank_size = build_prototypes(model, prototype_loader)\n",
    "        history.append({\"epoch\": epoch, \"train_loss\": loss, \"populated_pair_prototypes\": bank_size,\n",
    "                        \"fit_images\": len(fit)})\n",
    "        if not DEBUG:\n",
    "            tune = score_groups(model, {name: loader for name, loader in groups.items() if name.startswith(\"tune_\")})\n",
    "            grid = [{\"epoch\": epoch, \"lambda\": lam, **development_metrics(tune, \"tune\", fit_mask, lam)}\n",
    "                    for lam in LAMBDAS]\n",
    "            selection_grid.extend(grid)\n",
    "            current = max(grid, key=development_key)\n",
    "            if best is None or development_key(current) > development_key(best):\n",
    "                best, best_tune = current, tune\n",
    "                best_state = {name: tensor.detach().cpu().clone() for name, tensor in model.state_dict().items()}\n",
    "        print(history[-1], flush=True)\n",
    "    pd.DataFrame(history).to_csv(DEVELOPMENT_DIR / \"training_history.csv\", index=False)\n",
    "    if DEBUG:\n",
    "        return None\n",
    "\n",
    "    lam = best[\"lambda\"]\n",
    "    gamma_grid = [{\"gamma\": gamma, **development_metrics(best_tune, \"tune\", fit_mask, lam, gamma)}\n",
    "                  for gamma in GAMMAS]\n",
    "    gamma = max(gamma_grid, key=development_key)[\"gamma\"]\n",
    "    model.load_state_dict(best_state)\n",
    "    check = score_groups(model, {name: loader for name, loader in groups.items() if name.startswith(\"check_\")})\n",
    "    check_rows = [{\"scoring\": rule, \"gamma\": value, **development_metrics(check, \"check\", fit_mask, lam, value)}\n",
    "                  for rule, value in ((\"raw\", 0.), (\"calibrated\", gamma))]\n",
    "    ablations = []\n",
    "    for split, scores in ((\"tune\", best_tune), (\"check\", check)):\n",
    "        for recipe, blend, bank in ((\"cosine_only\", 0., 2), (\"global_prototypes_only\", 1., 1),\n",
    "                                    (\"conditional_prototypes_only\", 1., 2), (\"hybrid\", lam, 2)):\n",
    "            ablations.append({\"split\": split, \"recipe\": recipe, \"lambda\": blend,\n",
    "                              **development_metrics(scores, split, fit_mask, blend, prototype_index=bank)})\n",
    "\n",
    "    for filename, rows in ((\"raw_selection.csv\", selection_grid), (\"gamma_tune_grid.csv\", gamma_grid),\n",
    "                           (\"independent_check.csv\", check_rows), (\"ablation.csv\", ablations)):\n",
    "        pd.DataFrame(rows).to_csv(DEVELOPMENT_DIR / filename, index=False)\n",
    "    display(pd.DataFrame(check_rows))\n",
    "\n",
