    "@torch.no_grad()\n",
    "def frozen_prefix(backbone, images):\n",
    "    tokens = backbone.patch_embed(images)\n",
    "    tokens = backbone._pos_embed(tokens)\n",
    "    tokens = backbone.norm_pre(backbone.patch_drop(tokens))\n",
    "    for block in backbone.blocks[:-1]:\n",
    "        tokens = block(tokens)\n",
    "    return tokens\n",
    "\n",
    "\n",
    "def augment_blur(images, generator):\n",
    "    selected = torch.rand(len(images), generator=generator) < BLUR_PROB\n",
    "    if not selected.any():\n",
    "        return images\n",
    "    selected = selected.to(images.device)\n",
    "    augmented = images.clone()\n",
    "    augmented[selected] = TF.gaussian_blur(images[selected], kernel_size=[5, 5],\n",
    "                                           sigma=[BLUR_SIGMA, BLUR_SIGMA])\n",
    "    return augmented\n",
    "\n",
    "\n",
    "def center_logits(logits):\n",
    "    # Remove the per-image offset to which categorical predictions are invariant.\n",
    "    return logits - logits.mean(dim=1, keepdim=True)\n",
    "\n",
    "\n",
    "def decorrelation(crop, disease):\n",
    "    def standardize(x):\n",
    "        x = x - x.mean(0)\n",
    "        return x / (x.square().mean(0) + 1e-4).sqrt()\n",
    "\n",
    "    cross_correlation = standardize(crop).T @ standardize(disease) / len(crop)\n",
    "    return cross_correlation.square().mean()\n",
    "\n",
    "\n",
    "def cross_crop_supcon(embedding, crop, disease):\n",
    "    z = F.normalize(embedding, dim=1)\n",
    "    same_disease = disease[:, None].eq(disease[None, :])\n",
    "    positives = same_disease & crop[:, None].ne(crop[None, :])\n",
    "    negatives = ~same_disease\n",
    "    similarity = z @ z.T / TEMPERATURE\n",
    "    normalizer = similarity.masked_fill(~(positives | negatives), -1e9).logsumexp(dim=1)\n",
    "    counts = positives.sum(dim=1)\n",
    "    positive_mean = similarity.masked_fill(~positives, 0.0).sum(dim=1) / counts.clamp_min(1)\n",
    "    usable = (counts > 0) & negatives.any(dim=1)\n",
    "    per_anchor = (normalizer - positive_mean).masked_fill(~usable, 0.0)\n",
    "    return per_anchor.sum() / usable.sum().clamp_min(1), usable.sum()\n",
    "\n",
    "\n",
    "class CosineHead(nn.Module):\n",
    "    def __init__(self, width, classes):\n",
    "        super().__init__()\n",
    "        self.weight = nn.Parameter(torch.empty(classes, width))\n",
    "        nn.init.normal_(self.weight, std=0.02)\n",
    "\n",
    "    def forward(self, features):\n",
    "        return LOGIT_SCALE * F.linear(F.normalize(features, dim=1), F.normalize(self.weight, dim=1))\n",
    "\n",
    "\n",
    "class ConceptHeads(nn.Module):\n",
    "    def __init__(self, width, prefix_tokens):\n",
    "        super().__init__()\n",
    "        self.prefix_tokens = prefix_tokens\n",
    "        self.attention = nn.Sequential(nn.Linear(width, 128), nn.Tanh(), nn.Linear(128, 1, bias=False))\n",
    "        nn.init.zeros_(self.attention[-1].weight)\n",
    "        self.disease_projection = nn.Sequential(nn.LayerNorm(width), nn.Linear(width, 256))\n",
    "        self.crop_head = CosineHead(width, NUM_CROPS)\n",
    "        self.disease_head = CosineHead(256, NUM_DISEASES)\n",
    "\n",
    "    def forward(self, tokens, return_patches=False):\n",
    "        crop_feature = tokens[:, 0]\n",
    "        patches = tokens[:, self.prefix_tokens:]\n",
    "        attention = self.attention(patches).softmax(dim=1)\n",
    "        disease_feature = self.disease_projection((patches * attention).sum(dim=1))\n",
    "        outputs = (self.crop_head(crop_feature), self.disease_head(disease_feature), disease_feature)\n",
    "        return (*outputs, patches) if return_patches else outputs\n",
    "\n",
    "\n",
    "class PatchPairNet(nn.Module):\n",
    "    def __init__(self, pretrained):\n",
    "        super().__init__()\n",
    "        self.backbone = timm.create_model(BACKBONE, pretrained=pretrained, num_classes=0,\n",
    "                                          img_size=team.IMAGE_SIZE)\n",
    "        self.backbone.requires_grad_(False)\n",
    "        self.heads = ConceptHeads(self.backbone.num_features, self.backbone.num_prefix_tokens)\n",
    "\n",
    "    def forward(self, images):\n",
    "        return self.heads(self.backbone.forward_features(images))\n",
    "\n",
    "\n",
    "class FineTuneTail(nn.Module):\n",
    "    def __init__(self, model):\n",
    "        super().__init__()\n",
    "        self.block = copy.deepcopy(model.backbone.blocks[-1]).requires_grad_(True)\n",
    "        self.norm = copy.deepcopy(model.backbone.norm).requires_grad_(True)\n",
    "        self.heads = copy.deepcopy(model.heads)\n",
    "\n",
    "    def forward(self, tokens, return_patches=False):\n",
    "        return self.heads(self.norm(self.block(tokens)), return_patches=return_patches)\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def verify_prefix(model, tail, images):\n",
    "    for split, regular in zip(tail(frozen_prefix(model.backbone, images)), model(images)):\n",
    "        torch.testing.assert_close(split, regular, rtol=1e-5, atol=1e-6)\n",
    "\n",
    "\n",
    "def concept_pair_scores(crop_logits, disease_logits, pairs):\n",
    "    return crop_logits[:, pairs[:, 0]] + disease_logits[:, pairs[:, 1]]\n",
    "\n",
    "\n",
    "class PairRankingObjective(nn.Module):\n",
    "    def __init__(self, fit_pair_rows, pairs):\n",
    "        super().__init__()\n",
    "        count = torch.bincount(fit_pair_rows, minlength=len(pairs))\n",
    "        active = count.gt(0)\n",
    "        if active.sum().item() < 2:\n",
    "            raise ValueError(\"Pair ranking needs at least two fit pairs.\")\n",
    "        self.register_buffer(\"active\", active)\n",
    "        self.register_buffer(\"pairs\", pairs)\n",
    "        self.register_buffer(\"weights\", count.clamp_min(1).float().pow(-0.5))\n",
    "        self.hard_count = min(HARD_NEGATIVES, int(active.sum()) - 1)\n",
    "\n",
    "    def margins(self, crop, disease, pair_rows):\n",
    "        scores = concept_pair_scores(crop, disease, self.pairs)\n",
    "        target = scores.gather(1, pair_rows[:, None])\n",
    "        negatives = scores.masked_fill(~self.active[None, :], -torch.inf)\n",
    "        negatives = negatives.scatter(1, pair_rows[:, None], -torch.inf)\n",
    "        hardest = negatives.topk(self.hard_count, dim=1).values\n",
    "        return F.softplus(PAIR_MARGIN + hardest - target).mean(dim=1)\n",
    "\n",
    "    def forward(self, crop, disease, crop_labels, disease_labels, pair_rows):\n",
    "        weights = self.weights[pair_rows]\n",
    "        weights = weights / weights.sum()\n",
    "        crop_ce = F.cross_entropy(crop, crop_labels, label_smoothing=SMOOTHING)\n",
    "        disease_ce = F.cross_entropy(disease, disease_labels, reduction=\"none\", label_smoothing=SMOOTHING)\n",
    "        real_rank = torch.dot(weights, self.margins(crop, disease, pair_rows))\n",
    "\n",
    "        # Attach disease evidence from same-disease images of other crops to the anchor crop.\n",
    "        # The supervised target remains the anchor's real fit pair.\n",
    "        donors = disease_labels[:, None].eq(disease_labels) & crop_labels[:, None].ne(crop_labels)\n",
    "        donor_counts = donors.sum(dim=1)\n",
    "        recombined = (donors.to(disease.dtype) @ disease) / donor_counts.clamp_min(1)[:, None]\n",
    "        available = donor_counts > 0\n",
    "        transfer_weights = self.weights[pair_rows] * available\n",
    "        transfer_weights = transfer_weights / transfer_weights.sum().clamp_min(1e-8)\n",
    "        transfer_rank = torch.dot(transfer_weights, self.margins(crop, recombined, pair_rows))\n",
    "\n",
    "        total = crop_ce + torch.dot(weights, disease_ce) + RANK_WEIGHT * real_rank + TRANSFER_WEIGHT * transfer_rank\n",
    "        return total, real_rank, transfer_rank, available.sum()\n",
    "\n",
