{
  "seed": 42,
  "selected": [
    "R1"
  ],
  "epochs": 10,
  "batch_size": 8,
  "accumulation_steps": 4,
  "lr": 1e-05,
  "prompt_lr": 5e-05,
  "weight_decay": 0.05,
  "precision": "bf16",
  "partial_blocks": 6,
  "preservation_weight": 0.1,
  "pair_holdout_fraction": 0.1,
  "gradient_checkpointing": true,
  "text_batch_size": 16,
  "loss_weights": [
    1.0,
    0.5,
    0.5
  ],
  "score_grid": [
    [
      1,
      0,
      0
    ],
    [
      0.75,
      0.125,
      0.125
    ],
    [
      0.5,
      0.25,
      0.25
    ]
  ],
  "bias_grid": [
    0.0,
    -2.0,
    -1.0,
    1.0,
    2.0
  ],
  "adapter_dim": 64,
  "cmt_layers": 1,
  "cmt_initial_scale": 0.1,
  "smoke_images": 2,
  "dino_batch_size": 4,
  "protocol": "train_only_v2",
  "pair_prompt": "a photo of a {crop} leaf with {disease}",
  "crop_prompt": "a photo of a {crop} leaf",
  "disease_prompt": "a photo of a leaf with {disease}",
  "backbones": {
    "clip_b16": {
      "backend": "open_clip",
      "architecture": "ViT-B-16",
      "pretrained": "openai"
