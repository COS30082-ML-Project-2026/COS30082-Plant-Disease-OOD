    "siglip2": {
      "backend": "transformers",
      "repository": "google/siglip2-base-patch16-224",
      "revision": "main"
    }
  },
  "dino_repository": "facebook/dinov2-base",
  "dino_revision": "main",
  "dino_pooling": "last_hidden_state[:, 0, :] (CLS)"
}
